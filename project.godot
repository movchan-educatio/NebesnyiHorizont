[network]

limits/debugger/max_chars_per_second=65536
limits/debugger/max_queued_messages=500

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=16
3d/default_gravity=9.81
common/physics_interpolation=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
environment/ssao/quality=1
environment/ssil/quality=1
scaling_3d/scale=0.8
scaling_3d/fsr_sharpness=0.25
environment/volumetric_fog/volume_depth=48
environment/defaults/default_clear_color=Color(0.06, 0.08, 0.1, 1)
occlusion_culling/use_occlusion_culling=true
environment/defaults/default_environment="res://default_env.tres"
threads/thread_model=2
quality/directional_shadow/size=2048
lights_and_shadows/shadow_atlas/size=2048
quality/shadow_atlas/cubemap_size=1024
lights_and_shadows/shadow_atlas/quadrant_0_subdiv=2
lights_and_shadows/shadow_atlas/quadrant_1_subdiv=3
lights_and_shadows/shadow_atlas/quadrant_2_subdiv=4
lights_and_shadows/shadow_atlas/quadrant_3_subdiv=5
quality/shadows/filter_mode=1
quality/filters/anisotropic_filter_level=4
quality/reflections/atlas_size=1024
quality/filters/msaa=0
